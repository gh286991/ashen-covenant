[node name="BlenderDressingFinal" parent="." instance=ExtResource("6_dressing")]
rotation_degrees = Vector3(90, 0, 0)
editor_description = "Blender 白模型 review 後的純視覺敘事裝飾：碎石、封印石碑、斷柱與封鎖鐵柵。無碰撞、無導航、無互動，全部位於不可到達的外圍區域。"

[node name="AshenExteriorDressing" parent="." instance=ExtResource("7_exterior")]
editor_description = "灰燼前庭的第二層遠景：76 個子節點各自引用一個獨立 GLB。南側採用碎石緩衝、交錯斷崖與外圍墓園的三層邊界，左右以側崖收邊；可在本場景或 dungeon_grid_map.tscn 選取單件岩塊、墓碑、枯木、橋段、方尖碑與石塚後調整；無碰撞、無導航、無互動。"

[node name="AshenGroundDressing" parent="." instance=ExtResource("9_ground")]
editor_description = "灰燼前庭的近景地表過渡：73 個子節點各自引用一個獨立 GLB。南側以破碎舊路、灰燼沉積與散石銜接外牆，北側補上封鎖古道，左右肩部與支線外側用低矮碎石、刺灌與石塚消除空白；無碰撞、無導航、無互動。"

[node name="ExteriorCourtyardDressing" parent="." instance=ExtResource("10_courtyard")]
editor_description = "南側畫面中央的崩塌前庭：兩座低矮傾倒基座、兩段倒柱、碎石、破路塊與刺灌，讓南側外牆與外圍斷牆之間不再是一片空白。15 個直接子節點皆為可獨立調整的 GLB；無碰撞、無導航、無互動。"

[node name="ExteriorWildernessDressing" parent="." instance=ExtResource("11_wilderness")]
editor_description = "真正位於城牆外的廣域荒野：東西兩側與南方前景以岩丘、枯樹、殘碑和灰土延伸到鏡頭可見範圍。43 個直接子節點皆為可獨立調整的 GLB；無碰撞、無導航、無互動。"

[node name="ExteriorAtmosphere" type="Node3D" parent="."]
editor_description = "Compatibility renderer 友善的外圍氛圍：三盞無陰影魂光與一組低數量灰燼微粒。"

