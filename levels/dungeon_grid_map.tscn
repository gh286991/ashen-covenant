[node name="DungeonGridMap" type="Node3D"]
editor_description = "實際地圖在 ModularAssembly；NonPlayableFill 是可在本場景直接預覽的地下城外圍。房間四邊用牆封住，只在 Doorways 開入口；四組 GridMap 是隱藏筆刷參考層。"

[node name="NonPlayableFill" parent="." instance=ExtResource("9_exterior")]
editor_description = "可直接在本場景展開並編輯的外圍環境；編輯時會同時保留 ModularAssembly 原始地下城作為位置參考。純視覺，沒有碰撞、導航或互動。"

[node name="InteriorDressing" parent="." instance=ExtResource("10_interior")]
editor_description = "室內氛圍層：84 件無碰撞、可逐件選取的牆腳碎石、骨骸、斷柱、鏈條、木料與地表痕跡。中央戰鬥空間與門到門動線保持留白。"

