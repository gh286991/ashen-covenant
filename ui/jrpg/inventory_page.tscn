[node name="Header" type="HBoxContainer" parent="PageMargin/Page"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="PageMargin/Page/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.86, 0.55, 1)
theme_override_font_sizes/font_size = 26
text = "物品袋"

[node name="Capacity" type="Label" parent="PageMargin/Page/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.66, 0.7, 0.79, 1)
text = "持有 8 / 30　　金幣 1,240 G"
vertical_alignment = 1

[node name="Rule" type="HSeparator" parent="PageMargin/Page"]
layout_mode = 2

