[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://ui/jrpg/jrpg_theme.tres" id="1_theme"]
[ext_resource type="Texture2D" path="res://assets/ui/ability_icons/single-4.png" id="2_potion"]

[node name="InventoryPage" type="PanelContainer"]
custom_minimum_size = Vector2(1000, 500)
offset_right = 1000.0
offset_bottom = 500.0
theme = ExtResource("1_theme")

[node name="PageMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 22

[node name="Page" type="VBoxContainer" parent="PageMargin"]
